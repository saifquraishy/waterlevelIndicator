# Neon PostgreSQL connection string (set real value in .env or Render dashboard — never commit secrets)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Server port (optional locally; Render sets PORT automatically)
PORT=3000

# Restrict CORS to your GitHub Pages origin (no trailing path)
FRONTEND_ORIGIN=https://saifquraishy.github.io
